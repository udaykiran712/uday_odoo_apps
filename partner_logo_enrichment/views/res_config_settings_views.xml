<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_partner_logo_enrichment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.partner.logo.enrichment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']/block" position="inside">
                <setting id="logo_dev_api_key_setting" string="Logo.dev API Key"
                         help="Enter your Logo.dev API key to automatically fetch company logos"
                         documentation="https://logo.dev/docs">
                    <field name="logo_dev_api_key" placeholder="Paste your API key (pk_...)"/>
                    <div class="mt8">
                        <button name="action_test_logo_dev_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-link"
                                icon="fa-plug"/>
                    </div>
                </setting>
                <setting id="logo_fetch_immediate_setting" string="Immediate Logo Fetch"
                         help="Fetch logos immediately when partner is created/updated (may slow down UI)">
                    <field name="logo_fetch_immediate"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
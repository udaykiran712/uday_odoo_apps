<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_otp_unknown" model="mail.template">
        <field name="name">Email OTP Login: Unregistered Email Notice</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="subject">✉️ We couldn't find an account for this email</field>
        <field name="email_to">{{ ctx.get('attempted_login') }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f1f1f8"
                   style="background-color:#f1f1f8; padding:40px 0; font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                <tr>
                    <td align="center">
                        <table border="0" cellpadding="0" cellspacing="0" width="480"
                               style="max-width:480px; background-color:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 12px 40px rgba(245,158,11,0.16);">

                            <tr>
                                <td align="center" bgcolor="#f59e0b"
                                    style="background:linear-gradient(135deg,#f59e0b,#f97316); background-color:#f59e0b; padding:32px 32px 28px;">
                                    <table border="0" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td align="center" bgcolor="#ffffff"
                                                style="background-color:#ffffff; border-radius:14px; width:52px; height:52px; font-size:26px; line-height:52px;">
                                                🔍
                                            </td>
                                        </tr>
                                    </table>
                                    <div style="color:#ffffff; font-size:16px; font-weight:700; margin-top:14px;">
                                        <t t-out="object.name or 'Your Account'"/>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:32px;">
                                    <p style="margin:0 0 6px 0; font-size:17px; font-weight:700; color:#1e1b3a;">
                                        Hi there 👋
                                    </p>
                                    <p style="margin:0 0 24px 0; font-size:14px; color:#6b7091; line-height:1.65;">
                                        Someone (hopefully you!) just tried to log in to
                                        <t t-out="object.name or 'this account'"/>
                                        using this email address.
                                    </p>

                                    <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                           style="border-radius:16px; overflow:hidden; border:1px solid #fde3c7;">
                                        <tr>
                                            <td height="4" bgcolor="#f59e0b"
                                                style="background:linear-gradient(90deg,#f59e0b,#f97316); background-color:#f59e0b; font-size:1px; line-height:4px;">
                                                &#160;
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="center" bgcolor="#fffbf3"
                                                style="background-color:#fffbf3; padding:22px 20px;">
                                                <span style="font-size:13px; color:#7a5a1e;">We couldn't find an account
                                                    for
                                                </span>
                                                <div style="margin-top:6px; font-size:17px; font-weight:700; color:#92400e; word-break:break-all;">
                                                    <t t-out="ctx.get('attempted_login')"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>

                                    <p style="margin:20px 0 0 0; font-size:13px; color:#6b7091; line-height:1.6;">
                                        💡 If you have another email address, try logging in
                                        with that one instead. If you believe this is a
                                        mistake, contact your administrator.
                                    </p>

                                    <hr style="border:none; border-top:1px solid #eeeef7; margin:24px 0;"/>

                                    <p style="margin:0; font-size:13px; color:#8b8fb0; line-height:1.6;">
                                        🛡️ Didn't try to log in yourself? No action is needed — no
                                        account exists for this address, so there's nothing to
                                        protect.
                                    </p>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:16px 32px; background-color:#faf9ff; border-top:1px solid #eeeef7;">
                                    <p style="margin:0; font-size:11px; color:#a3a3c4;">
                                        This is an automated message — please don't reply to this email.
                                    </p>
                                </td>
                            </tr>

                        </table>
                    </td>
                </tr>
            </table>
        </field>
    </record>
</odoo>